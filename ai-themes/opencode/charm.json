{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "ink": "#201f26",
    "inkPanel": "#27232f",
    "inkElement": "#302d3a",
    "line": "#3a3546",
    "muted": "#625b6a",
    "textDark": "#e6dfed",
    "cream": "#fffdf5",
    "violet": "#9671ff",
    "violetLight": "#6b50ff",
    "mint": "#00ffb2",
    "greenLight": "#087a56",
    "cyan": "#0adcd9",
    "red": "#ff6daa",
    "redLight": "#b42352",
    "orange": "#ff9d76",
    "orangeLight": "#b95738",
    "lime": "#ecfd65",
    "limeLight": "#657800",
    "purple": "#c89cff",
    "purpleLight": "#7644ad",
    "lightBg": "#fffdf5",
    "lightPanel": "#f4eff9",
    "lightElement": "#eee7f7",
    "lightLine": "#e5dcee",
    "lightText": "#201f26",
    "lightMuted": "#81798c"
  },
  "theme": {
    "primary": { "dark": "violet", "light": "violetLight" },
    "secondary": { "dark": "purple", "light": "purpleLight" },
    "accent": { "dark": "mint", "light": "greenLight" },
    "error": { "dark": "red", "light": "redLight" },
    "warning": { "dark": "lime", "light": "limeLight" },
    "success": { "dark": "mint", "light": "greenLight" },
    "info": { "dark": "cyan", "light": "#007c85" },
    "text": { "dark": "cream", "light": "lightText" },
    "textMuted": { "dark": "#9b93a3", "light": "lightMuted" },
    "background": { "dark": "ink", "light": "lightBg" },
    "backgroundPanel": { "dark": "inkPanel", "light": "lightPanel" },
    "backgroundElement": { "dark": "inkElement", "light": "lightElement" },
    "border": { "dark": "line", "light": "lightLine" },
    "borderActive": { "dark": "violet", "light": "violetLight" },
    "borderSubtle": { "dark": "#302d3a", "light": "#e5dcee" },
    "diffAdded": { "dark": "mint", "light": "greenLight" },
    "diffRemoved": { "dark": "red", "light": "redLight" },
    "diffContext": { "dark": "#9b93a3", "light": "lightMuted" },
    "diffHunkHeader": { "dark": "purple", "light": "purpleLight" },
    "diffHighlightAdded": { "dark": "mint", "light": "greenLight" },
    "diffHighlightRemoved": { "dark": "red", "light": "redLight" },
    "diffAddedBg": { "dark": "#292630", "light": "#e5dcee" },
    "diffRemovedBg": { "dark": "#30232d", "light": "#f5edff" },
    "diffContextBg": { "dark": "inkPanel", "light": "lightPanel" },
    "diffLineNumber": { "dark": "muted", "light": "#bfbcc8" },
    "markdownText": { "dark": "cream", "light": "lightText" },
    "markdownHeading": { "dark": "violet", "light": "violetLight" },
    "markdownLink": { "dark": "cyan", "light": "#007c85" },
    "markdownLinkText": { "dark": "mint", "light": "greenLight" },
    "markdownCode": { "dark": "mint", "light": "greenLight" },
    "markdownBlockQuote": { "dark": "#9b93a3", "light": "lightMuted" },
    "markdownEmph": { "dark": "orange", "light": "orangeLight" },
    "markdownStrong": { "dark": "lime", "light": "limeLight" },
    "markdownHorizontalRule": { "dark": "muted", "light": "#bfbcc8" },
    "markdownListItem": { "dark": "violet", "light": "violetLight" },
    "markdownListEnumeration": { "dark": "mint", "light": "greenLight" },
    "markdownImage": { "dark": "purple", "light": "purpleLight" },
    "markdownImageText": { "dark": "mint", "light": "greenLight" },
    "markdownCodeBlock": { "dark": "#e6dfed", "light": "lightText" },
    "syntaxComment": { "dark": "#857d8e", "light": "#81798c" },
    "syntaxKeyword": { "dark": "purple", "light": "purpleLight" },
    "syntaxFunction": { "dark": "violet", "light": "violetLight" },
    "syntaxVariable": { "dark": "cream", "light": "lightText" },
    "syntaxString": { "dark": "mint", "light": "greenLight" },
    "syntaxNumber": { "dark": "orange", "light": "orangeLight" },
    "syntaxType": { "dark": "cyan", "light": "#007c85" },
    "syntaxOperator": { "dark": "purple", "light": "purpleLight" },
    "syntaxPunctuation": { "dark": "#e6dfed", "light": "lightText" }
  }
}
